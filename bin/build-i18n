#!/usr/bin/env ruby
# Regenerates the Liquid the theme actually uses from the YAML Weblate owns.
#
# Why the detour: Jekyll themes only share _layouts, _includes, _sass and
# assets, so a _data/i18n.yml would be invisible to every site consuming this
# theme through `remote_theme`. The strings therefore have to end up in an
# _includes file — but Liquid is no format to hand to translators, so YAML is
# the source and the include is generated and committed.
#
# Run with --check to verify the committed includes match the YAML; CI does.

require 'yaml'

ROOT = File.expand_path('..', __dir__)
LANGS = YAML.load_file(File.join(ROOT, 'i18n/languages.yml'))
BASE = 'en'

def liquid_string(value)
  # Liquid single-quoted strings have no escape sequences, so everything is
  # double-quoted; no string here may contain a double quote.
  raise "a double quote would break the Liquid literal: #{value}" if value.include?('"')
  %("#{value}")
end

def load_strings
  base = YAML.load_file(File.join(ROOT, "i18n/strings/#{BASE}.yml"))
  sets = { BASE => base }
  LANGS.each_key do |lang|
    next if lang == BASE
    path = File.join(ROOT, "i18n/strings/#{lang}.yml")
    next unless File.exist?(path)     # not translated yet: falls back to English
    translated = YAML.load_file(path) || {}
    unknown = translated.keys - base.keys
    raise "i18n/strings/#{lang}.yml has keys the base does not: #{unknown.join(', ')}" if unknown.any?
    # A missing or empty string falls back to English rather than rendering blank.
    sets[lang] = base.merge(translated.reject { |_, v| v.to_s.strip.empty? })
  end
  [base, sets]
end

def build_i18n(base, sets)
  out = +<<~HEAD
    {%- comment -%}
    Interface strings of the theme. GENERATED by bin/build-i18n from i18n/strings/*.yml —
    edit the YAML, not this file.

    They live in an include and not in `_data/`: Jekyll themes only share
    `_layouts`, `_includes`, `_sass` and `assets`, so a `_data/i18n.yml` would be
    invisible to the sites consuming this theme through `remote_theme`.

    `cur_lang` comes from the page `lang` variable, which consuming sites set with
    path-scoped `defaults` in their _config.yml. A language with no catalogue, or
    an unknown one, falls back on English.

    Liquid includes share the caller's scope, so every variable assigned below is
    usable in the layout right after `{% include i18n.html %}`.
    {%- endcomment -%}
    {%- comment -%}
    The language comes from the first path segment when that segment is a known
    language, so a site needs no per-language `defaults` and a translation Weblate
    adds is picked up with no change to the plugin repository. An explicit page
    `lang` still wins.
    {%- endcomment -%}
    {%- assign known_langs = "#{LANGS.keys.join(',')}" | split: ',' -%}
    {%- assign url_parts = page.url | remove_first: '/' | split: '/' -%}
    {%- comment -%}
    No need to check the depth: a page at the root has a file name as its first
    segment (documentation.html) or none at all, and neither can equal a language
    code — while /fr/ has a single segment and must still be recognised.
    {%- endcomment -%}
    {%- if known_langs contains url_parts[0] -%}
      {%- assign path_lang = url_parts[0] -%}
    {%- endif -%}
    {%- assign cur_lang = page.lang | default: path_lang | default: site.default_lang | default: 'en' -%}
    {%- comment -%}
    Directory and Weblate codes use an underscore (pt_BR); HTML lang and hreflang
    need the BCP 47 form (pt-BR), or the markup is invalid.
    {%- endcomment -%}
    {%- assign cur_html_lang = cur_lang | replace: '_', '-' -%}
    {%- assign rtl_langs = "#{LANGS.select { |_, v| v['rtl'] }.keys.join(',')}" | split: ',' -%}
    {%- if rtl_langs contains cur_lang -%}{%- assign cur_dir = 'rtl' -%}{%- else -%}{%- assign cur_dir = 'ltr' -%}{%- endif -%}
    {%- case cur_lang -%}
  HEAD

  # Every language listed in languages.yml gets a branch, even without a
  # catalogue: it then carries the English strings but keeps its own `cur_lang`,
  # so the page still declares the right language and text direction.
  LANGS.each_key do |lang|
    strings = sets[lang] || base
    out << "{%- when '#{lang}' -%}\n"
    base.each_key { |key| out << "  {%- assign #{key} = #{liquid_string(strings[key])} -%}\n" }
  end
  out << "{%- else -%}\n"
  out << "  {%- assign cur_lang = 'en' -%}\n"
  out << "  {%- assign cur_html_lang = 'en' -%}\n"
  out << "  {%- assign cur_dir = 'ltr' -%}\n"
  base.each { |key, value| out << "  {%- assign #{key} = #{liquid_string(value)} -%}\n" }
  out << "{%- endcase -%}\n"
  out
end

def build_lang_names
  out = +<<~HEAD
    {%- comment -%}
    Resolves a language code to its native name, and assigns it to `lang_name`.
    GENERATED by bin/build-i18n from i18n/languages.yml — edit the YAML.

    Usage: {% include lang-name.html lang=some_lang %}
    {%- endcomment -%}
    {%- case include.lang -%}
  HEAD
  LANGS.each { |lang, meta| out << "{%- when '#{lang}' -%}{%- assign lang_name = #{liquid_string(meta['name'])} -%}\n" }
  out << "{%- else -%}{%- assign lang_name = include.lang -%}\n{%- endcase -%}\n"
  out
end

base, sets = load_strings
generated = {
  '_includes/i18n.html' => build_i18n(base, sets),
  '_includes/lang-name.html' => build_lang_names,
}

if ARGV.include?('--check')
  stale = generated.reject { |path, body| File.exist?(File.join(ROOT, path)) && File.read(File.join(ROOT, path)) == body }
  unless stale.empty?
    warn "out of date, run bin/build-i18n: #{stale.keys.join(', ')}"
    exit 1
  end
  puts "includes match i18n/strings/*.yml (#{LANGS.size} languages, #{sets.size} with a catalogue)"
else
  generated.each { |path, body| File.write(File.join(ROOT, path), body) }
  translated = sets.size
  puts "wrote #{generated.keys.join(' and ')}"
  puts "#{LANGS.size} languages, #{translated} with their own strings, " \
       "#{LANGS.size - translated} falling back on English"
end
