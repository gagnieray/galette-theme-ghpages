#!/usr/bin/env bash
# Regenerates _includes/galette-version.html: which Galette is current, and which
# plugin compatibility version it demands.
#
# Why this lives in the theme and not in each site: it is one value, the same for
# every plugin page, and it changes when *Galette* releases — not when a plugin
# does. A plugin's own _data/galette.yml is written by its release workflow and
# would stay put for months, so the comparison would go stale exactly when it
# starts to matter. An _includes file, on the other hand, is shared through
# `remote_theme`, and a commit touching _includes/ already rebuilds every
# consuming site.
#
# The value is read at the source rather than derived from the tag name:
# GALETTE_COMPAT_VERSION is what Plugins::register() actually compares against.
#
#   GALETTE_REPO   repository to read      (default galette/galette)
#   CHECK          set to 1 to verify the committed include is up to date
#
# Needs gh authenticated for a public read; no write anywhere.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="${GALETTE_REPO:-galette/galette}"
OUT="${ROOT}/_includes/galette-version.html"
DEMO="${ROOT}/_data/galette.yml"
VERSIONS='galette/includes/sys_config/versions.inc.php'

tag=$(gh api "repos/${REPO}/releases/latest" --jq '.tag_name') || {
  echo "::error::could not read the latest release of ${REPO}"
  exit 1
}

# Not the tag: a release named 1.2.1 carries GALETTE_COMPAT_VERSION 1.2.0, and
# nothing promises that mapping holds for ever.
src=$(gh api "repos/${REPO}/contents/${VERSIONS}?ref=${tag}" --jq '.content' | base64 -d) || {
  echo "::error::could not read ${VERSIONS} at ${tag} of ${REPO}"
  exit 1
}
compat=$(printf '%s' "$src" \
  | sed -nE "s@^define\('GALETTE_COMPAT_VERSION', '([^']+)'\).*@\1@p" | head -n1)
if [ -z "$compat" ]; then
  echo "::error::${VERSIONS} at ${tag} declares no GALETTE_COMPAT_VERSION"
  exit 1
fi

# A generation for the reader — "1.2", not "1.2.0" — and a rank for Liquid, which
# has no version comparison of its own. Padded so a plain integer comparison
# orders releases correctly: 1.2.0 -> 1002000, 1.10.0 -> 1010000.
series=$(printf '%s' "$compat" | cut -d. -f1,2)
rank=$(printf '%s' "$compat" | awk -F. '{printf "%d", $1 * 1000000 + $2 * 1000 + $3}')

body=$(cat <<LIQUID
{%- comment -%}
Which Galette a plugin page compares itself against. GENERATED by
bin/refresh-galette-version from the latest release of ${REPO} — do not edit.

\`galette_compat\` is GALETTE_COMPAT_VERSION as that release declares it: the
plugin compatibility version this Galette demands. Plugins::register() disables a
plugin whose own compver is lower, and imposes no upper bound, so a plugin is
compatible exactly when its rank is greater than or equal to the one below.

It sits in an include rather than in \`_data/\` because Jekyll themes only share
\`_layouts\`, \`_includes\`, \`_sass\` and \`assets\`: a \`_data/\` file here would be
invisible to the sites consuming this theme through \`remote_theme\`.
{%- endcomment -%}
{%- assign galette_version = "${tag}" -%}
{%- assign galette_compat = "${compat}" -%}
{%- assign galette_compat_series = "${series}" -%}
{%- assign galette_compat_rank = ${rank} -%}
LIQUID
)

# The demo site's own fixture, standing in for what a plugin's release workflow
# writes onto its Pages branch. It is generated here and not written by hand for
# one reason: a fixed rank would fall behind the include the day Galette releases,
# turning the demo — and the CI assertion that reads it — red on their own.
#
# `release` has to match what the cartouche names, which for the demo is
# `plugin.version` in its _config.yml.
demo_release=$(sed -nE 's/^[[:space:]]+version:[[:space:]]*"([^"]+)".*/\1/p' "${ROOT}/_config.yml" | head -n1)
if [ -z "$demo_release" ]; then
  echo "::error::no plugin.version in _config.yml, so the demo fixture cannot name the release the cartouche shows"
  exit 1
fi
demo=$(cat <<YAML
# The theme's own demo site only. Jekyll themes share _layouts, _includes, _sass
# and assets and nothing else, so this file reaches no consuming site — each one
# gets its own, written by galette/.github/actions/release-plugin at each release.
#
# GENERATED by bin/refresh-galette-version alongside
# _includes/galette-version.html, so the demo always shows the compatible state
# and never goes stale on a Galette release. \`release\` mirrors plugin.version in
# _config.yml, which is what the cartouche names.
release: "${demo_release}"
compver: "${compat}"
series: "${series}"
rank: ${rank}
YAML
)

if [ "${CHECK:-0}" = "1" ]; then
  stale=''
  [ "$(cat "$OUT" 2>/dev/null)" != "$body" ] && stale="_includes/galette-version.html"
  [ "$(cat "$DEMO" 2>/dev/null)" != "$demo" ] && stale="${stale:+$stale, }_data/galette.yml"
  if [ -n "$stale" ]; then
    echo "out of date, run bin/refresh-galette-version: ${stale}"
    exit 1
  fi
  echo "_includes/galette-version.html and _data/galette.yml match ${REPO} ${tag} (compat ${compat})"
  exit 0
fi

printf '%s\n' "$body" > "$OUT"
echo "wrote _includes/galette-version.html: Galette ${tag}, compat ${compat} (rank ${rank})"

printf '%s\n' "$demo" > "$DEMO"
echo "wrote _data/galette.yml: the demo site's own fixture, in step with the above"
