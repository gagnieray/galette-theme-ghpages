#!/bin/sh
# Serve the demo site locally, on the toolchain GitHub Pages actually uses.
#
# On Ruby 3.2 and later that toolchain cannot start on its own: the liquid 4.0.3
# the github-pages gem pins calls `tainted?`, which Ruby removed. Giving it back
# for the duration of the run is enough, and is far better than building with a
# newer Jekyll — that one loads none of the plugins github-pages brings, and
# jekyll-relative-links among them changes what the pages contain.
set -e

shim="${TMPDIR:-/tmp}/jekyll-untaint.rb"
if ! ruby -e 'Object.new.tainted?' >/dev/null 2>&1; then
  printf '%s\n' 'class Object; def tainted?; false; end; def untaint; self; end; end' > "$shim"
  export RUBYOPT="-r${shim} ${RUBYOPT:-}"
fi

bundle exec jekyll serve "$@"
